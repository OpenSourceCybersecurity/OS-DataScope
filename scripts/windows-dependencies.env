# Third-party programs that the install package bundles for DataScope-Setup (D169). Read by scripts/package.sh.
# Change a version and its SHA-256 together; the build refuses a download that doesn't match.

# PostgreSQL for Windows x64, the binaries zip from EDB (https://www.enterprisedb.com/download-postgresql-binaries).
POSTGRESQL_VERSION=16.15-1
POSTGRESQL_URL=https://get.enterprisedb.com/postgresql/postgresql-16.15-1-windows-x64-binaries.zip
POSTGRESQL_SHA256=25e6fcdfb8caec38691bf461125e7564508760666f7b8e5dc6a5f0818f58f81e

# The Microsoft Visual C++ Redistributable (2015-2022, x64), which PostgreSQL and text recognition need. Microsoft only
# publishes it at a "latest" address, so it is not pinned here: the installer checks Microsoft's signature on it
# before running it, and the SBOM records the SHA-256 of the copy that shipped.
VC_REDIST_URL=https://aka.ms/vs/17/release/vc_redist.x64.exe
