<Project Sdk="Microsoft.NET.Sdk">
  <!-- The setup wizard's logic, with no Windows calls, so it is tested on any platform. DataScope-Setup.exe compiles
       these same files into itself (it targets .NET Framework 4.7.2, which every supported Windows Server has, so it
       runs before anything is installed and stays one small file). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>DataScope.Installer</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="DataScope.Installer.Tests" />
  </ItemGroup>
</Project>
