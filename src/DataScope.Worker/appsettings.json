{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Scanner": {
    "PollSeconds": 5,
    "LeaseSeconds": 60,
    "MaxDepth": 64,
    "MaxEntriesPerFolder": 200000,
